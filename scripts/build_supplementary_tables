"""
Build Supplementary Tables A1-A4 for the IL-10 / MASLD-HCC paper
(biomedicines-4237763 revision).

Structure:
  A1 — Cohort metadata (40 samples, curated)
  A2 — Differential expression of IL-10 axis genes across 6 contrasts
  A3 — Cell-type signature panel with gene-level provenance
  A4 — Signature scores, ANOVA, and correlations with IL-10 axis

Deliverables:
  /mnt/user-data/outputs/supplementary/Supplementary_Tables_A1-A4.xlsx
  /mnt/user-data/outputs/supplementary/TableA1_cohort.csv
  /mnt/user-data/outputs/supplementary/TableA2_DE_IL10axis.csv
  /mnt/user-data/outputs/supplementary/TableA3_signature_panel.csv
  /mnt/user-data/outputs/supplementary/TableA4_scores_correlations.csv
"""
import numpy as np
import pandas as pd
import os
import pickle
from openpyxl import Workbook
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
from openpyxl.utils import get_column_letter
from openpyxl.styles import NamedStyle

OUT = '/mnt/user-data/outputs/supplementary'
os.makedirs(OUT, exist_ok=True)

# ----- shared style helpers -----
HEADER_FILL = PatternFill('solid', start_color='1F4E79')     # dark blue
HEADER_FONT = Font(bold=True, color='FFFFFF', name='Arial', size=10)
SUBHEADER_FILL = PatternFill('solid', start_color='BDD7EE')  # light blue
SUBHEADER_FONT = Font(bold=True, color='000000', name='Arial', size=10)
NORMAL_FONT = Font(name='Arial', size=10)
NOTE_FONT = Font(name='Arial', size=9, italic=True, color='555555')
THIN = Side(border_style='thin', color='999999')
BORDER = Border(left=THIN, right=THIN, top=THIN, bottom=THIN)

def style_header_row(ws, row_num, n_cols, fill=HEADER_FILL, font=HEADER_FONT):
    for c in range(1, n_cols + 1):
        cell = ws.cell(row=row_num, column=c)
        cell.fill = fill
        cell.font = font
        cell.alignment = Alignment(horizontal='center', vertical='center', wrap_text=True)
        cell.border = BORDER

def style_data_cell(ws, row, col, align='left'):
    cell = ws.cell(row=row, column=col)
    cell.font = NORMAL_FONT
    cell.alignment = Alignment(horizontal=align, vertical='center', wrap_text=False)
    cell.border = BORDER

def autosize(ws, max_width=50):
    for col_cells in ws.columns:
        max_len = 0
        letter = get_column_letter(col_cells[0].column)
        for cell in col_cells:
            if cell.value is None: continue
            s = str(cell.value)
            if len(s) > max_len:
                max_len = len(s)
        ws.column_dimensions[letter].width = min(max_len + 2, max_width)

def write_df_to_sheet(ws, df, start_row=1, freeze_header=True):
    """Write dataframe with formatted header + data rows."""
    # Header row
    for j, col in enumerate(df.columns, start=1):
        ws.cell(row=start_row, column=j, value=str(col))
    style_header_row(ws, start_row, len(df.columns))

    # Data
    for i, (_, row) in enumerate(df.iterrows(), start=start_row + 1):
        for j, v in enumerate(row.values, start=1):
            if pd.isna(v):
                cell_val = ''
            elif isinstance(v, (float, np.floating)):
                if abs(v) < 1e-3 and v != 0:
                    cell_val = float(f'{v:.3e}')
                else:
                    cell_val = round(float(v), 4)
            elif isinstance(v, (int, np.integer)):
                cell_val = int(v)
            else:
                cell_val = str(v)
            ws.cell(row=i, column=j, value=cell_val)
            align = 'right' if isinstance(v, (float, np.floating, int, np.integer)) else 'left'
            style_data_cell(ws, i, j, align=align)

    # Freeze header
    if freeze_header:
        ws.freeze_panes = ws.cell(row=start_row + 1, column=1)

# =========================================================================
# Create workbook
# =========================================================================
wb = Workbook()
# Remove default blank sheet
wb.remove(wb.active)

# =========================================================================
# TABLE A1 — Cohort metadata
# =========================================================================
print("Building Table A1 — Cohort metadata...")

cohort = pd.read_csv('/home/claude/cohort_final.csv')
counts = pd.read_csv('/home/claude/counts_final.csv', index_col=0)
sra = pd.read_csv('/mnt/user-data/uploads/SraRunTable__3_.csv')

# Compute library sizes
lib_M = counts.sum(axis=0) / 1e6
cohort['library_size_M'] = cohort['column_name'].map(lib_M.to_dict())

# Merge SRA run IDs (match by GSM)
# SRA has 'Sample Name' (=GSM) or 'Library Name'
sra_match = sra[['Run', 'Sample Name', 'BioSample', 'Experiment']].copy()
sra_match.columns = ['SRA_Run', 'GSM', 'BioSample', 'SRA_Experiment']
# Deduplicate (some samples may have multiple runs)
sra_match = sra_match.drop_duplicates('GSM', keep='first')
cohort_merged = cohort.merge(sra_match, on='GSM', how='left')

# Build the A1 table
A1 = pd.DataFrame({
    'Sample_ID':           cohort_merged['column_name'],
    'GEO_accession':       cohort_merged['GSM'],
    'SRA_Run':             cohort_merged['SRA_Run'],
    'BioSample':           cohort_merged['BioSample'],
    'Stage':               cohort_merged['group'],
    'Stage_label':         cohort_merged['group'].map({
        'S1_Control_07w':    'Healthy control (7w)',
        'S2a_EarlyMASLD_14w':'Early MASLD (14w)',
        'S3_MASH_20w':       'MASH (20w)',
        'S4_Fibrosis_32w':   'Liver fibrosis (32w)',
        'S2b_ChronicNT_56w': 'Chronic inflam. non-tumor (56w)',
        'S5_HCC':            'HCC tumor (44-56w)',
    }),
    'Age_weeks':           cohort_merged['age'].str.replace(' weeks', '', regex=False),
    'Diet':                cohort_merged['diet'].replace({'SCD': 'Standard chow',
                                                          'HFD': 'High-fat diet'}),
    'STZ_treatment':       cohort_merged['STZ'],
    'Drug_treatment':      cohort_merged['drug'],
    'Tissue':              cohort_merged['tissue'],
    'Sex':                 cohort_merged['sex'],
    'Genotype':            cohort_merged['genotype'],
    'Strain':              cohort_merged['strain'],
    'Sequencing_batch':    cohort_merged['batch'],
    'Library_size_M':      cohort_merged['library_size_M'].round(2),
    'GEO_original_title':  cohort_merged['Title'],
})

# Order by stage then sample ID
stage_sort_key = {
    'S1_Control_07w': 1, 'S2a_EarlyMASLD_14w': 2, 'S3_MASH_20w': 3,
    'S4_Fibrosis_32w': 4, 'S2b_ChronicNT_56w': 5, 'S5_HCC': 6
}
A1['_sort'] = A1['Stage'].map(stage_sort_key)
A1 = A1.sort_values(['_sort', 'Sample_ID']).drop(columns='_sort').reset_index(drop=True)

# Create sheet A1
ws1 = wb.create_sheet('Table A1 - Cohort')
ws1['A1'] = ('Table A1. Curated transcriptomic cohort from GSE246221 used in this re-analysis '
             '(n=40 biologically independent samples from the STZ+HFD mouse model).')
ws1['A1'].font = Font(bold=True, name='Arial', size=11)
ws1.merge_cells(start_row=1, start_column=1, end_row=1, end_column=len(A1.columns))
ws1['A1'].alignment = Alignment(horizontal='left', vertical='center', wrap_text=True)

ws1['A2'] = ('Cohort curation excluded 5 HFD-only Batch2 samples (Batch2_HFDonly20w_1–5) and '
             'all pharmacological intervention samples (Tirzepatide + vehicle controls, n=10 '
             'from the full GSE246221 series), to ensure a clean natural-history trajectory '
             'of STZ+HFD disease progression within Batch1. Stage assignments follow age, diet, '
             'STZ treatment, and histological annotation (see Table A1b for histology).')
ws1['A2'].font = NOTE_FONT
ws1.merge_cells(start_row=2, start_column=1, end_row=2, end_column=len(A1.columns))
ws1['A2'].alignment = Alignment(horizontal='left', vertical='top', wrap_text=True)
ws1.row_dimensions[2].height = 45

write_df_to_sheet(ws1, A1, start_row=4)

# Add summary footer with n per stage
footer_row = len(A1) + 6
ws1.cell(row=footer_row, column=1, value='Summary by stage:').font = Font(bold=True, name='Arial', size=10)
for i, (stage, n) in enumerate(A1['Stage'].value_counts().reindex(stage_sort_key.keys()).items(), start=footer_row + 1):
    ws1.cell(row=i, column=1, value=f'  {stage}')
    ws1.cell(row=i, column=2, value=f'n = {n}')
    ws1.cell(row=i, column=1).font = NORMAL_FONT
    ws1.cell(row=i, column=2).font = NORMAL_FONT

autosize(ws1)

# Save CSV
A1.to_csv(os.path.join(OUT, 'TableA1_cohort.csv'), index=False)
print(f"  Table A1: {len(A1)} rows × {len(A1.columns)} cols")

# =========================================================================
# TABLE A1b — Histological grading (from existing Methods doc Table S1)
# =========================================================================
A1b = pd.DataFrame([
    ['Stage 1', 'Healthy control',             '7w',     5,  '100% Gr0',                           '100% Gr0',                            '100% F0'],
    ['Stage 2a','Early MASLD',                 '14w',    5,  '71% Gr2 / 29% Gr1',                  '100% Gr1',                            '86% F0 / 14% F1'],
    ['Stage 3', 'MASH',                        '20w',    5,  '60% Gr3 / 30% Gr2 / 10% Gr1',        '80% Gr1 / 10% Gr2 / 10% Gr0',         '50% F1 / 50% F0'],
    ['Stage 4', 'Liver fibrosis',              '32w',    5,  '70% Gr3 / 30% Gr2',                  '40% Gr2 / 30% Gr3 / 30% Gr1',         '60% F2 / 20% F3 / 20% F1'],
    ['Stage 2b','Chronic inflam. (non-tumor)', '56w',    6,  '78% Gr3 / 11% Gr2 / 11% Gr1',        '56% Gr2 / 33% Gr1 / 11% Gr0',         '44% F3 / 33% F2 / 22% F1'],
    ['Stage 5', 'HCC (tumor)',                 '44-56w', 14, 'Neoplastic tissue',                  'Neoplastic tissue',                   'Neoplastic tissue'],
], columns=['Transcriptomic_stage','Pathological_classification','Age','n',
            'Steatosis_grade','Lobular_inflammation','Fibrosis_stage'])

ws1b = wb.create_sheet('Table A1b - Histology')
ws1b['A1'] = ('Table A1b. Temporal histological frequencies of the STZ+HFD model, '
              'corresponding to the transcriptomic cohort stages.')
ws1b['A1'].font = Font(bold=True, name='Arial', size=11)
ws1b.merge_cells(start_row=1, start_column=1, end_row=1, end_column=len(A1b.columns))

ws1b['A2'] = ('Histological frequencies reflect the population-level pathology of the '
              'age-matched STZ+HFD groups from which the transcriptomic samples were derived. '
              'Tumor incidence for Stage 5 progressed from 50.0% (44w) to 88.9% (56w). '
              'Gr = Grade; F = Fibrosis Stage.')
ws1b['A2'].font = NOTE_FONT
ws1b.merge_cells(start_row=2, start_column=1, end_row=2, end_column=len(A1b.columns))
ws1b['A2'].alignment = Alignment(horizontal='left', vertical='top', wrap_text=True)
ws1b.row_dimensions[2].height = 45

write_df_to_sheet(ws1b, A1b, start_row=4)
autosize(ws1b, max_width=30)

A1b.to_csv(os.path.join(OUT, 'TableA1b_histology.csv'), index=False)
print(f"  Table A1b: {len(A1b)} rows × {len(A1b.columns)} cols")

# =========================================================================
# TABLE A2 — Differential expression of IL-10 axis across 6 contrasts
# =========================================================================
print("Building Table A2 — IL-10 axis DE results...")

axis_genes = ['Il10', 'Il10ra', 'Il10rb', 'Stat3', 'Jak1', 'Jak2', 'Tyk2',
              'Socs3', 'Il6st', 'Scd2', 'Ddit4']
contrasts = [
    'EarlyMASLD_vs_Control', 'MASH_vs_EarlyMASLD', 'Fibrosis_vs_MASH',
    'ChronicNT_vs_Fibrosis', 'HCC_vs_ChronicNT', 'HCC_vs_Control',
]

rows_limma = []
for c in contrasts:
    df = pd.read_csv(f'/home/claude/deg/{c}.csv')
    for g in axis_genes:
        hit = df[df['gene'].str.endswith('_' + g)]
        if len(hit) == 0:
            rows_limma.append({
                'gene': g, 'contrast': c,
                'logFC': np.nan, 'SE': np.nan, 't': np.nan,
                'P_value': np.nan, 'FDR_BH': np.nan,
                'detected': 'no (sub-threshold)'
            })
        else:
            r = hit.iloc[0]
            SE = abs(r['logFC'] / r['t']) if r['t'] != 0 else np.nan
            rows_limma.append({
                'gene': g, 'contrast': c,
                'logFC': r['logFC'], 'SE': SE, 't': r['t'],
                'P_value': r['P.Value'], 'FDR_BH': r['adj.P.Val'],
                'detected': 'yes'
            })
A2_limma = pd.DataFrame(rows_limma)
A2_limma['method'] = 'limma-voom (robust + trend eBayes)'

# PyDESeq2 sensitivity
rows_deseq = []
for c in contrasts:
    try:
        df = pd.read_csv(f'/home/claude/deg_deseq2/{c}.csv')
        for g in axis_genes:
            hit = df[df['gene'].str.endswith('_' + g)]
            if len(hit) == 0:
                rows_deseq.append({'gene': g, 'contrast': c,
                                   'logFC': np.nan, 'SE': np.nan, 't': np.nan,
                                   'P_value': np.nan, 'FDR_BH': np.nan,
                                   'detected': 'no (sub-threshold)',
                                   'method': 'PyDESeq2 (Wald test, rounded counts)'})
            else:
                r = hit.iloc[0]
                rows_deseq.append({'gene': g, 'contrast': c,
                                   'logFC': r.get('log2FoldChange', np.nan),
                                   'SE':    r.get('lfcSE', np.nan),
                                   't':     r.get('stat', np.nan),
                                   'P_value': r.get('pvalue', np.nan),
                                   'FDR_BH':  r.get('padj', np.nan),
                                   'detected': 'yes',
                                   'method': 'PyDESeq2 (Wald test, rounded counts)'})
    except FileNotFoundError:
        continue

A2_deseq = pd.DataFrame(rows_deseq)

# F-test longitudinal
F_df = pd.read_csv('/home/claude/deg/F_test_any_stage.csv')
rows_ftest = []
for g in axis_genes:
    hit = F_df[F_df['gene'].str.endswith('_' + g)]
    if len(hit) == 0:
        rows_ftest.append({'gene': g, 'F_statistic': np.nan, 'P_value': np.nan,
                           'FDR_BH': np.nan, 'detected': 'no (sub-threshold)'})
    else:
        r = hit.iloc[0]
        rows_ftest.append({'gene': g, 'F_statistic': r['F'],
                           'P_value': r['P.Value'], 'FDR_BH': r['adj.P.Val'],
                           'detected': 'yes'})
A2_ftest = pd.DataFrame(rows_ftest)
A2_ftest['test'] = 'limma-voom F-test (any-stage difference, 5 contrast df)'

# Save: A2 = limma-voom primary; A2b = PyDESeq2 sensitivity; A2c = F-test
ws2 = wb.create_sheet('Table A2a - DE limma-voom')
ws2['A1'] = ('Table A2a. Differential expression of IL-10 axis genes across six stage-wise '
             'contrasts (limma-voom with robust + trend empirical Bayes; primary method).')
ws2['A1'].font = Font(bold=True, name='Arial', size=11)
ws2.merge_cells(start_row=1, start_column=1, end_row=1, end_column=len(A2_limma.columns))

ws2['A2'] = ('logFC, log2 fold change; SE, moderated standard error (logFC / t); '
             't, moderated t-statistic; FDR_BH, Benjamini–Hochberg adjusted P-value. '
             'Genes not passing the cohort filter (CPM ≥ 0.5 in ≥ 3 samples, e.g., Il10) '
             'are marked sub-threshold.')
ws2['A2'].font = NOTE_FONT
ws2.merge_cells(start_row=2, start_column=1, end_row=2, end_column=len(A2_limma.columns))
ws2['A2'].alignment = Alignment(horizontal='left', vertical='top', wrap_text=True)
ws2.row_dimensions[2].height = 45
write_df_to_sheet(ws2, A2_limma, start_row=4)
autosize(ws2, max_width=28)

A2_limma.to_csv(os.path.join(OUT, 'TableA2a_DE_limma.csv'), index=False)
print(f"  Table A2a (limma): {len(A2_limma)} rows")

ws2b = wb.create_sheet('Table A2b - DE PyDESeq2')
ws2b['A1'] = ('Table A2b. Sensitivity analysis: differential expression of IL-10 axis genes '
              'using PyDESeq2 (Wald test on rounded counts) as an orthogonal method.')
ws2b['A1'].font = Font(bold=True, name='Arial', size=11)
ws2b.merge_cells(start_row=1, start_column=1, end_row=1, end_column=len(A2_deseq.columns))

ws2b['A2'] = ('logFC, log2 fold change (Wald estimator); SE, LFC standard error; '
              't, Wald statistic. Concordance with Table A2a (limma-voom): '
              'Pearson r of logFC values across all contrasts = 0.88–0.98.')
ws2b['A2'].font = NOTE_FONT
ws2b.merge_cells(start_row=2, start_column=1, end_row=2, end_column=len(A2_deseq.columns))
ws2b['A2'].alignment = Alignment(horizontal='left', vertical='top', wrap_text=True)
ws2b.row_dimensions[2].height = 45
write_df_to_sheet(ws2b, A2_deseq, start_row=4)
autosize(ws2b, max_width=34)

A2_deseq.to_csv(os.path.join(OUT, 'TableA2b_DE_PyDESeq2.csv'), index=False)
print(f"  Table A2b (DESeq2): {len(A2_deseq)} rows")

ws2c = wb.create_sheet('Table A2c - F-test')
ws2c['A1'] = ('Table A2c. Longitudinal F-test for any-stage differential expression '
              '(limma-voom F-test, all 5 contrasts simultaneously).')
ws2c['A1'].font = Font(bold=True, name='Arial', size=11)
ws2c.merge_cells(start_row=1, start_column=1, end_row=1, end_column=len(A2_ftest.columns))
write_df_to_sheet(ws2c, A2_ftest, start_row=4)
autosize(ws2c, max_width=34)

A2_ftest.to_csv(os.path.join(OUT, 'TableA2c_Ftest.csv'), index=False)
print(f"  Table A2c (F-test): {len(A2_ftest)} rows")

# =========================================================================
# TABLE A3 — Cell-type signature panel with provenance
# =========================================================================
print("Building Table A3 — Signature panel...")

sig_panel = pd.read_csv('/home/claude/celltypes4/signature_panel.csv')

# Rename columns for clarity in publication
A3 = sig_panel.rename(columns={
    'signature': 'Cell_type_signature',
    'gene': 'Gene_symbol',
    'detected_in_dataset': 'Detected_in_cohort',
    'sources': 'Primary_sources',
    'IL10_role': 'Role_in_IL10_axis',
})
# Convert True/False to Yes/No
A3['Detected_in_cohort'] = A3['Detected_in_cohort'].map({True: 'Yes', False: 'No'})

# Nice labels
sig_label_map = {
    'Hepatocytes':            'Hepatocytes (parenchymal)',
    'Macrophages_Monocytes':  'Macrophages & Monocytes (myeloid)',
    'NK_cells':               'NK cells (innate lymphoid)',
    'HSC_Fibrosis':           'Hepatic stellate cells / Fibrosis',
}
A3['Cell_type_signature'] = A3['Cell_type_signature'].map(sig_label_map).fillna(A3['Cell_type_signature'])

ws3 = wb.create_sheet('Table A3 - Signature panel')
ws3['A1'] = ('Table A3. Cell-type signature panel used for compartment enrichment scoring, '
             'with gene-level provenance and role in the IL-10 axis.')
ws3['A1'].font = Font(bold=True, name='Arial', size=11)
ws3.merge_cells(start_row=1, start_column=1, end_row=1, end_column=len(A3.columns))

ws3['A2'] = ('Signatures were curated from CellMarker 2.0 (Hu et al. 2023 Nucleic Acids Research) '
             'filtered to Liver tissue entries plus HCC-related samples, retaining markers cited by '
             '≥ 2 independent PMIDs (consensus threshold). Literature-canonical markers were added '
             'for MASLD/HCC-specific subsets (e.g., Trem2, Clec4f for Kupffer cells). '
             'Scoring was performed as the median log2-CPM of detected signature genes per sample.')
ws3['A2'].font = NOTE_FONT
ws3.merge_cells(start_row=2, start_column=1, end_row=2, end_column=len(A3.columns))
ws3['A2'].alignment = Alignment(horizontal='left', vertical='top', wrap_text=True)
ws3.row_dimensions[2].height = 60

write_df_to_sheet(ws3, A3, start_row=4)
# Widen the narrative columns
ws3.column_dimensions['D'].width = 55  # sources
ws3.column_dimensions['E'].width = 55  # IL10 role
# Enable wrap text for narrative
for row in ws3.iter_rows(min_row=5, max_row=4 + len(A3), min_col=4, max_col=5):
    for cell in row:
        cell.alignment = Alignment(vertical='top', wrap_text=True)
        ws3.row_dimensions[cell.row].height = 45
autosize(ws3, max_width=55)
# Re-enforce wrapping after autosize
ws3.column_dimensions['D'].width = 55
ws3.column_dimensions['E'].width = 55

A3.to_csv(os.path.join(OUT, 'TableA3_signature_panel.csv'), index=False)
print(f"  Table A3: {len(A3)} rows")

# =========================================================================
# TABLE A4 — Signature scores, ANOVA, correlations with IL-10 axis
# =========================================================================
print("Building Table A4 — Scores, ANOVA, correlations...")

# 4a. Per-sample scores (both median and z-score)
scores_median = pd.read_csv('/home/claude/celltypes4/scores_median.csv', index_col=0)
scores_zscore = pd.read_csv('/home/claude/celltypes4/scores_zscore.csv', index_col=0)
cohort_idx = cohort.set_index('column_name')['group'].to_dict()

A4a_list = []
for s in scores_median.index:
    row = {'Sample_ID': s, 'Stage': cohort_idx.get(s, '?')}
    for pop in scores_median.columns:
        row[f'{pop}_median_log2CPM'] = scores_median.loc[s, pop]
        row[f'{pop}_z_score']        = scores_zscore.loc[s, pop]
    A4a_list.append(row)
A4a = pd.DataFrame(A4a_list)
# Order by stage
A4a['_sort'] = A4a['Stage'].map(stage_sort_key)
A4a = A4a.sort_values(['_sort', 'Sample_ID']).drop(columns='_sort').reset_index(drop=True)

ws4a = wb.create_sheet('Table A4a - Per-sample scores')
ws4a['A1'] = ('Table A4a. Per-sample signature scores for the four liver compartments '
              '(median log2-CPM of detected signature genes and row-wise mean z-score).')
ws4a['A1'].font = Font(bold=True, name='Arial', size=11)
ws4a.merge_cells(start_row=1, start_column=1, end_row=1, end_column=len(A4a.columns))
write_df_to_sheet(ws4a, A4a, start_row=3)
autosize(ws4a, max_width=30)

A4a.to_csv(os.path.join(OUT, 'TableA4a_scores.csv'), index=False)
print(f"  Table A4a: {len(A4a)} samples × {len(A4a.columns)} cols")

# 4b. ANOVA + Kruskal–Wallis per signature + group means
anova_df = pd.read_csv('/home/claude/celltypes4/anova_per_signature.csv')
# Relabel cell type names
anova_df['signature'] = anova_df['signature'].map(sig_label_map).fillna(anova_df['signature'])
# Rename columns
anova_df = anova_df.rename(columns={
    'signature': 'Cell_type_signature',
    'F': 'F_statistic_ANOVA', 'P_ANOVA': 'P_ANOVA',
    'H_KW': 'H_statistic_KruskalWallis', 'P_KW': 'P_KruskalWallis',
    'n_detected': 'Genes_detected', 'n_total': 'Genes_total',
    'FDR_ANOVA': 'FDR_ANOVA_BH', 'FDR_KW': 'FDR_KW_BH',
    'mean_S1_Control_07w':     'Mean_Control_7w',
    'mean_S2a_EarlyMASLD_14w': 'Mean_EarlyMASLD_14w',
    'mean_S3_MASH_20w':        'Mean_MASH_20w',
    'mean_S4_Fibrosis_32w':    'Mean_Fibrosis_32w',
    'mean_S2b_ChronicNT_56w':  'Mean_ChronicNT_56w',
    'mean_S5_HCC':             'Mean_HCC',
})
# Reorder
cols_order = ['Cell_type_signature', 'Genes_detected', 'Genes_total',
              'F_statistic_ANOVA', 'P_ANOVA', 'FDR_ANOVA_BH',
              'H_statistic_KruskalWallis', 'P_KruskalWallis', 'FDR_KW_BH',
              'Mean_Control_7w', 'Mean_EarlyMASLD_14w', 'Mean_MASH_20w',
              'Mean_Fibrosis_32w', 'Mean_ChronicNT_56w', 'Mean_HCC']
anova_df = anova_df[cols_order]

ws4b = wb.create_sheet('Table A4b - ANOVA per signature')
ws4b['A1'] = ('Table A4b. Stage-wise one-way ANOVA (parametric) and Kruskal–Wallis '
              '(non-parametric) across the six disease stages for each compartment '
              'signature, with group means.')
ws4b['A1'].font = Font(bold=True, name='Arial', size=11)
ws4b.merge_cells(start_row=1, start_column=1, end_row=1, end_column=len(anova_df.columns))

ws4b['A2'] = ('FDR_BH, Benjamini–Hochberg adjusted P-value across the four signatures. '
              'Group means are the mean of per-sample median log2-CPM scores within each stage.')
ws4b['A2'].font = NOTE_FONT
ws4b.merge_cells(start_row=2, start_column=1, end_row=2, end_column=len(anova_df.columns))
ws4b['A2'].alignment = Alignment(horizontal='left', vertical='top', wrap_text=True)
ws4b.row_dimensions[2].height = 35
write_df_to_sheet(ws4b, anova_df, start_row=4)
autosize(ws4b, max_width=28)

anova_df.to_csv(os.path.join(OUT, 'TableA4b_ANOVA.csv'), index=False)
print(f"  Table A4b: {len(anova_df)} signatures")

# 4c. Pairwise Holm-adjusted contrasts per signature
with open('/home/claude/celltypes4/blob.pkl', 'rb') as f:
    blob = pickle.load(f)
dunn_res = blob['dunn_results']

group_readable = {
    'S1_Control_07w': 'Control_7w', 'S2a_EarlyMASLD_14w': 'EarlyMASLD_14w',
    'S3_MASH_20w': 'MASH_20w', 'S4_Fibrosis_32w': 'Fibrosis_32w',
    'S2b_ChronicNT_56w': 'ChronicNT_56w', 'S5_HCC': 'HCC',
}
rows_dunn = []
for pop, pairs in dunn_res.items():
    for (a, b), p in pairs.items():
        rows_dunn.append({
            'Cell_type_signature': sig_label_map.get(pop, pop),
            'Group_A': group_readable.get(a, a),
            'Group_B': group_readable.get(b, b),
            'P_adj_Holm': p,
            'Significant_0.05': 'yes' if (pd.notna(p) and p < 0.05) else 'no',
        })
A4c = pd.DataFrame(rows_dunn)

ws4c = wb.create_sheet('Table A4c - Pairwise post-hoc')
ws4c['A1'] = ('Table A4c. Pairwise Mann-Whitney U tests between all 15 stage pairs for each '
              'compartment signature, with Holm–Bonferroni adjustment (per signature).')
ws4c['A1'].font = Font(bold=True, name='Arial', size=11)
ws4c.merge_cells(start_row=1, start_column=1, end_row=1, end_column=len(A4c.columns))
write_df_to_sheet(ws4c, A4c, start_row=3)
autosize(ws4c, max_width=28)

A4c.to_csv(os.path.join(OUT, 'TableA4c_posthoc.csv'), index=False)
print(f"  Table A4c: {len(A4c)} pairwise contrasts")

# 4d. Correlations with IL-10 axis
corr_r = pd.read_csv('/home/claude/celltypes4/il10_correlations_r.csv', index_col=0)
corr_p = pd.read_csv('/home/claude/celltypes4/il10_correlations_p.csv', index_col=0)
corr_fdr = pd.read_csv('/home/claude/celltypes4/il10_correlations_fdr.csv', index_col=0)

# Long-format for easy reading
rows_corr = []
for pop in corr_r.index:
    for gene in corr_r.columns:
        r = corr_r.loc[pop, gene]
        p = corr_p.loc[pop, gene]
        fdr = corr_fdr.loc[pop, gene]
        sig_str = '***' if (pd.notna(fdr) and fdr < 0.001) else \
                  '**'  if (pd.notna(fdr) and fdr < 0.01)  else \
                  '*'   if (pd.notna(fdr) and fdr < 0.05)  else 'ns'
        rows_corr.append({
            'Cell_type_signature': sig_label_map.get(pop, pop),
            'IL10_axis_gene': gene,
            'Pearson_r': r,
            'P_value': p,
            'FDR_BH': fdr,
            'Significance': sig_str,
        })
A4d = pd.DataFrame(rows_corr)

ws4d = wb.create_sheet('Table A4d - IL10 correlations')
ws4d['A1'] = ('Table A4d. Pearson correlations between compartment signature scores and '
              'IL-10 axis gene expression (log2-CPM), with BH-adjusted P-values.')
ws4d['A1'].font = Font(bold=True, name='Arial', size=11)
ws4d.merge_cells(start_row=1, start_column=1, end_row=1, end_column=len(A4d.columns))

ws4d['A2'] = ('Significance: *** FDR<0.001, ** FDR<0.01, * FDR<0.05, ns = not significant. '
              'FDR adjustment is over the full 4 × 10 correlation matrix (40 comparisons).')
ws4d['A2'].font = NOTE_FONT
ws4d.merge_cells(start_row=2, start_column=1, end_row=2, end_column=len(A4d.columns))
ws4d['A2'].alignment = Alignment(horizontal='left', vertical='top', wrap_text=True)
ws4d.row_dimensions[2].height = 35
write_df_to_sheet(ws4d, A4d, start_row=4)
autosize(ws4d, max_width=30)

A4d.to_csv(os.path.join(OUT, 'TableA4d_IL10_correlations.csv'), index=False)
print(f"  Table A4d: {len(A4d)} correlations")

# =========================================================================
# Save workbook
# =========================================================================
xlsx_path = os.path.join(OUT, 'Supplementary_Tables_A1-A4.xlsx')
wb.save(xlsx_path)
print(f"\nWorkbook saved: {xlsx_path}")
print(f"Sheets: {wb.sheetnames}")
